# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.dev-pid

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 本地截图预览（临时产物，不要提交）
/.preview/

# Cloudflare 本地开发密钥（含 ADMIN_KEY，绝不能提交）
.dev.vars
.wrangler/

# Setup 向导状态（记录进度与生成的密钥明文，绝不能提交）
/.setup/

# Trae 本地配置与技能（含个人工作流信息，不入仓库）
/.trae/
